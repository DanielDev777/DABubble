# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-generate-a-real-one
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=dabubble
POSTGRES_USER=dabubble
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# CORS (Angular dev origin)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Auth cookies
AUTH_COOKIE_SECURE=False

# Google auth (real values live in .env, never committed)
GOOGLE_AUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_AUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Redis (Channels layer)
REDIS_HOST=redis
REDIS_PORT=6379

# Frontend origin used to build password-reset links
FRONTEND_URL=http://localhost:4200

# Email (console backend prints to the container log in dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@dabubble.local

# Password-reset link lifetime in seconds
PASSWORD_RESET_TIMEOUT=3600
